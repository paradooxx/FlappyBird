{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "MinGW Makefiles"
            ]
        },
        {
            "label": "Run Game",
            "type": "shell",
            "command": "${workspaceFolder}/build/flappybird.exe",
            "group": "build"
        },
        {
            "label": "Build and Run",
            "dependsOrder": "sequence",
            "dependsOn": ["CMake Build", "Run Game"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}